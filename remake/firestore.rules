rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(data) {
      return signedIn() && (
        data.players[0].uid == request.auth.uid ||
        (data.players.size() > 1 && data.players[1].uid == request.auth.uid)
      );
    }
    match /rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.host == request.auth.uid
        && request.resource.data.players.size() == 1
        && request.resource.data.players[0].uid == request.auth.uid;
      allow get: if signedIn();
      allow list: if false;
      allow update: if signedIn() && (
        isMember(resource.data) ||
        (resource.data.players.size() == 1
          && request.resource.data.players.size() == 2
          && request.resource.data.players[1].uid == request.auth.uid
          && request.resource.data.host == resource.data.host)
      );
      allow delete: if signedIn() && resource.data.host == request.auth.uid;
    }
    match /matches/{matchId} {
      allow read: if signedIn() && request.auth.uid in resource.data.playerIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.playerIds;
      allow update, delete: if false;
    }
    match /leaderboard/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
      match /matches/{matchId} {
        allow read, create, update: if signedIn() && request.auth.uid == userId;
        allow delete: if false;
      }
    }
    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }
  }
}