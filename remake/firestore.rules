rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(data) {
      return signedIn()
        && data.keys().hasAll(['players'])
        && data.players is list
        && data.players.size() >= 1
        && data.players.size() <= 2
        && (
          data.players[0].uid == request.auth.uid
          || (data.players.size() == 2 && data.players[1].uid == request.auth.uid)
        );
    }

    function validPlayer(player) {
      return player is map
        && player.keys().hasAll(['uid', 'name', 'score', 'correct', 'wrong'])
        && player.uid is string
        && player.name is string
        && player.name.size() <= 20
        && player.score is number
        && player.correct is number
        && player.wrong is number;
    }

    function validPlayerProgress(oldPlayer, newPlayer, submittedAnswer, expectedAnswer) {
      return newPlayer.diff(oldPlayer).affectedKeys().hasOnly(['score', 'correct', 'wrong'])
        && newPlayer.uid == oldPlayer.uid
        && newPlayer.name == oldPlayer.name
        && newPlayer.score == oldPlayer.score + (submittedAnswer.correct ? 10 : 0)
        && newPlayer.correct == oldPlayer.correct + (submittedAnswer.correct ? 1 : 0)
        && newPlayer.wrong == oldPlayer.wrong + (submittedAnswer.correct ? 0 : 1)
        && submittedAnswer.option is string
        && submittedAnswer.correct is bool
        && submittedAnswer.correct == (submittedAnswer.option == expectedAnswer);
    }

    function isHostRoundUpdate() {
      return signedIn()
        && resource.data.host == request.auth.uid
        && isMember(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'round', 'question', 'options', 'answer',
          'answers', 'endsAt', 'finishedAt'
        ])
        && request.resource.data.host == resource.data.host
        && request.resource.data.code == resource.data.code
        && request.resource.data.players == resource.data.players
        && request.resource.data.answers is map
        && (
          (
            resource.data.status == 'waiting'
            && request.resource.data.status == 'playing'
            && resource.data.players.size() == 2
            && request.resource.data.round == 1
            && request.resource.data.answers.size() == 0
          )
          || (
            resource.data.status == 'round-complete'
            && request.resource.data.status == 'playing'
            && request.resource.data.round == resource.data.round + 1
            && request.resource.data.answers.size() == 0
          )
          || (
            resource.data.status == 'round-complete'
            && request.resource.data.status == 'finished'
            && request.resource.data.round == resource.data.round
          )
        );
    }

    function isValidPlayerAnswerUpdate() {
      let answer = request.resource.data.answers[request.auth.uid];
      return signedIn()
        && resource.data.status == 'playing'
        && resource.data.players.size() == 2
        && isMember(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'answers', 'players', 'status'
        ])
        && request.resource.data.answers is map
        && !resource.data.answers.keys().hasAny([request.auth.uid])
        && request.resource.data.answers.diff(resource.data.answers).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.answers.keys().size() == resource.data.answers.keys().size() + 1
        && answer is map
        && answer.keys().hasOnly(['option', 'correct'])
        && request.resource.data.players is list
        && request.resource.data.players.size() == 2
        && (
          (
            resource.data.players[0].uid == request.auth.uid
            && validPlayerProgress(resource.data.players[0], request.resource.data.players[0], answer, resource.data.answer)
            && request.resource.data.players[1] == resource.data.players[1]
          )
          || (
            resource.data.players[1].uid == request.auth.uid
            && validPlayerProgress(resource.data.players[1], request.resource.data.players[1], answer, resource.data.answer)
            && request.resource.data.players[0] == resource.data.players[0]
          )
        )
        && request.resource.data.status == (
          request.resource.data.answers.keys().size() >= request.resource.data.players.size()
            ? 'round-complete'
            : 'playing'
        );
    }

    match /rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'code', 'host', 'status', 'round', 'question', 'options',
          'answer', 'players', 'answers', 'createdAt'
        ])
        && request.resource.data.code == roomId
        && request.resource.data.host == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.players is list
        && request.resource.data.players.size() == 1
        && validPlayer(request.resource.data.players[0])
        && request.resource.data.players[0].uid == request.auth.uid;

      allow get: if signedIn()
        && resource.data.code == roomId
        && (
          isMember(resource.data)
          || (
            resource.data.status == 'waiting'
            && resource.data.players is list
            && resource.data.players.size() == 1
          )
        );
      allow list: if false;

      allow update: if signedIn() && (
        isHostRoundUpdate()
        || isValidPlayerAnswerUpdate()
        || (
          resource.data.code == roomId
          && resource.data.status == 'waiting'
          && resource.data.players is list
          && resource.data.players.size() == 1
          && request.resource.data.players is list
          && request.resource.data.players.size() == 2
          && request.resource.data.players[0].uid == resource.data.players[0].uid
          && request.resource.data.players[1].uid == request.auth.uid
          && validPlayer(request.resource.data.players[1])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players'])
          && request.resource.data.host == resource.data.host
        )
      );
      allow delete: if signedIn() && resource.data.host == request.auth.uid;
    }

    match /matches/{matchId} {
      allow read: if signedIn()
        && resource.data.playerIds is list
        && request.auth.uid in resource.data.playerIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'roomCode', 'rounds', 'players', 'playerIds', 'winnerUid', 'completedAt'
        ])
        && request.resource.data.playerIds is list
        && request.resource.data.playerIds.size() == 2
        && request.auth.uid in request.resource.data.playerIds
        && request.resource.data.players is list
        && request.resource.data.players.size() == 2
        && (
          request.resource.data.winnerUid == null
          || request.resource.data.winnerUid in request.resource.data.playerIds
        );
      allow update, delete: if false;
    }

    match /leaderboard/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'totalScore', 'wins', 'matches', 'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20
        && request.resource.data.totalScore is number
        && request.resource.data.wins is number
        && request.resource.data.matches is number;
      allow delete: if false;

      match /matches/{matchId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['matchId', 'completedAt'])
          && request.resource.data.matchId == matchId;
        allow delete: if false;
      }
    }

    match /users/{userId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'savedWords', 'displayName',
          'xp', 'totalCorrect', 'totalAnswered', 'currentStreak',
          'bestStreak', 'lastActiveDay', 'dailyKey', 'dailyDone',
          'dailyGoal', 'achievements', 'updatedAt',
          'soloScore', 'soloTotal', 'soloCorrect',
          'ieltsWritingDraft', 'ieltsWritingUpdatedAt'
        ]);
      match /learningEvents/{eventId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['kind', 'word', 'correct', 'createdAt'])
          && request.resource.data.kind is string
          && request.resource.data.word is string
          && request.resource.data.correct is bool;
        allow update, delete: if false;
      }
    }
  }
}